.home-page {
  min-height: 100vh;
  padding: 18rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
}

.home-brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 10rpx 4rpx 34rpx;
}

.brand-seal {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid var(--line-strong);
  border-radius: 50%;
  background: rgba(234, 219, 184, 0.42);
}

.brand-seal-text {
  color: var(--gold);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.brand-copy,
.tool-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.brand-copy {
  gap: 7rpx;
}

.brand-title {
  color: var(--ink);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 0.03em;
  line-height: 1.1;
}

.brand-subtitle {
  color: var(--ink-soft);
  font-size: 23rpx;
  line-height: 1.4;
}

.tool-list {
  border-top: 1rpx solid var(--line);
}

.tool-entry {
  width: 100%;
  min-height: 118rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 0;
  padding: 21rpx 8rpx;
  border: 0;
  border-bottom: 1rpx solid var(--line);
  border-radius: 0;
  background: transparent;
  color: var(--ink);
  line-height: 1.2;
  text-align: left;
}

.tool-entry::after {
  border: 0;
}

.tool-entry-active {
  background: rgba(234, 219, 184, 0.3);
}

.tool-symbol {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 17rpx;
  background: rgba(234, 219, 184, 0.52);
  color: var(--gold);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
}

.tool-copy {
  flex: 1;
  gap: 8rpx;
}

.tool-title {
  overflow: hidden;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.28;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-description {
  overflow: hidden;
  color: var(--ink-soft);
  font-size: 23rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-chevron {
  width: 13rpx;
  height: 13rpx;
  flex-shrink: 0;
  margin-right: 6rpx;
  border-right: 2rpx solid var(--ink-faint);
  border-bottom: 2rpx solid var(--ink-faint);
  transform: rotate(-45deg);
}

.home-footer {
  padding: 30rpx 4rpx 0;
}

.home-boundary {
  display: block;
  color: var(--ink-faint);
  font-size: 21rpx;
  line-height: 1.5;
}

.utility-links {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 15rpx;
}

.utility-link {
  color: var(--gold);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.5;
}

.utility-dot {
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: var(--line-strong);
}
