.home-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(38rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 88% 8%, rgba(63, 101, 120, 0.07), transparent 32%),
    var(--paper);
}

.hero {
  position: relative;
  overflow: hidden;
  padding: calc(env(safe-area-inset-top) + 82rpx) 34rpx 78rpx;
  border-radius: 0 0 40rpx 40rpx;
  background: #ffffff;
  color: #1b1f22;
}

.hero::after {
  content: "";
  position: absolute;
  right: -90rpx;
  bottom: -150rpx;
  width: 360rpx;
  height: 360rpx;
  border: 1rpx solid rgba(63, 101, 120, 0.14);
  border-radius: 50%;
}

.hero-watermark {
  position: absolute;
  right: 22rpx;
  top: -34rpx;
  color: rgba(27, 31, 34, 0.035);
  font-size: 270rpx;
  font-weight: 700;
  line-height: 1;
}

.brand-lockup {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-seal {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid #cfd7dc;
  border-radius: 18rpx;
  background: #eef3f5;
}

.brand-seal-text {
  color: #3f6578;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

.brand-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 7rpx;
}

.brand-title {
  color: #1b1f22;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 1.08;
}

.brand-subtitle {
  color: #737b82;
  font-size: 22rpx;
  letter-spacing: 0.08em;
  line-height: 1.4;
}

.hero-meta {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 42rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #e3e7ea;
  color: #8b9298;
  font-size: 20rpx;
  letter-spacing: 0.14em;
}

.home-main {
  position: relative;
  z-index: 2;
  margin-top: -42rpx;
  padding: 0 28rpx;
}

.dewater-card {
  position: relative;
  overflow: hidden;
  padding: 26rpx 24rpx 22rpx;
  border: 1rpx solid #e0e4e7;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 44rpx rgba(23, 36, 43, 0.06);
  transition: transform 140ms cubic-bezier(0.16, 1, 0.3, 1), border-color 140ms ease;
}

.dewater-card::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 170rpx;
  height: 170rpx;
  background: radial-gradient(circle at 100% 0, rgba(63, 101, 120, 0.08), transparent 70%);
  pointer-events: none;
}

.dewater-card-active {
  transform: scale(0.988);
  border-color: #9cb6c2;
}

.dewater-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.dewater-kicker,
.dewater-range,
.dewater-label,
.dewater-value,
.dewater-return {
  display: block;
}

.dewater-kicker {
  color: #1b1f22;
  font-size: 27rpx;
  font-weight: 700;
}

.dewater-range {
  margin-top: 6rpx;
  color: #7b848b;
  font-size: 19rpx;
}

.dewater-link {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #3f6578;
  font-size: 20rpx;
  font-weight: 600;
}

.dewater-link .tool-chevron {
  margin: 0;
  transform: rotate(-45deg);
}

.dewater-compare {
  display: flex;
  align-items: stretch;
  margin-top: 24rpx;
  padding: 22rpx 0 18rpx;
  border-top: 1rpx solid #e3e7ea;
}

.dewater-metric {
  min-width: 0;
  flex: 1;
}

.dewater-rule {
  width: 1rpx;
  margin: 0 22rpx;
  background: #e3e7ea;
}

.dewater-label {
  color: #6f777d;
  font-size: 19rpx;
}

.dewater-value {
  margin-top: 8rpx;
  color: #1f2428;
  font-size: 42rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
  line-height: 1.08;
}

.dewater-value.is-accent {
  color: #3f6578;
}

.dewater-return {
  margin-top: 8rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.dewater-chart {
  width: 100%;
  height: 142rpx;
  display: block;
}

.dewater-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 7rpx;
  color: #899198;
  font-size: 18rpx;
  font-variant-numeric: tabular-nums;
}

.dewater-stale {
  display: block;
  margin-top: 12rpx;
  color: #3f6578;
  font-size: 18rpx;
}

.dewater-skeleton {
  min-height: 300rpx;
  color: #737b82;
  font-size: 21rpx;
}

.skeleton-line {
  width: 68%;
  height: 18rpx;
  margin-bottom: 14rpx;
  border-radius: 10rpx;
  background: #e9edf0;
}

.skeleton-line.wide { width: 92%; }
.skeleton-line.short { width: 45%; }

.dewater-error {
  min-height: 180rpx;
  display: flex;
  justify-content: center;
  flex-direction: column;
}

.dewater-error-title,
.dewater-error-copy {
  display: block;
}

.dewater-error-title {
  color: #1f2428;
  font-size: 26rpx;
  font-weight: 700;
}

.dewater-error-copy {
  margin-top: 9rpx;
  color: #737b82;
  font-size: 21rpx;
  line-height: 1.5;
}

.tool-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 30rpx 2rpx 14rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--line);
}

.tool-section-title {
  color: #33393e;
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.tool-section-count {
  color: #8b9298;
  font-size: 18rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.12em;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.tool-card {
  min-height: 206rpx;
  display: flex;
  align-items: stretch;
  flex-direction: column;
  margin: 0;
  padding: 24rpx 22rpx 22rpx;
  overflow: hidden;
  border: 1rpx solid #e0e4e7;
  border-radius: 28rpx;
  background: #ffffff;
  color: var(--ink);
  line-height: 1.2;
  text-align: left;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.84);
  animation: tool-card-in 460ms cubic-bezier(0.16, 1, 0.3, 1) both;
  transition: transform 140ms cubic-bezier(0.16, 1, 0.3, 1), border-color 140ms ease, background-color 140ms ease;
}

.tool-card::after {
  border: 0;
}

.tool-card:nth-child(2) { animation-delay: 45ms; }
.tool-card:nth-child(3) { animation-delay: 90ms; }
.tool-card:nth-child(4) { animation-delay: 135ms; }
.tool-card:nth-child(5) { animation-delay: 180ms; }
.tool-card:nth-child(6) { animation-delay: 225ms; }

.tool-card-active {
  transform: scale(0.985);
  border-color: #9cb6c2;
  background: #f1f5f7;
}

.tool-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.tool-icon-shell {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dbe3e7;
  border-radius: 17rpx;
  background: #eef3f5;
}

.tool-icon {
  width: 34rpx;
  height: 34rpx;
}

.tool-chevron {
  width: 12rpx;
  height: 12rpx;
  margin-top: 18rpx;
  margin-right: 4rpx;
  border-right: 1.5rpx solid #8d969c;
  border-bottom: 1.5rpx solid #8d969c;
  transform: rotate(-45deg);
}

.tool-title {
  display: block;
  margin-top: auto;
  padding-top: 24rpx;
  color: #1b1f22;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.01em;
  line-height: 1.3;
}

.tool-description {
  display: block;
  margin-top: 7rpx;
  color: #69727a;
  font-size: 20rpx;
  line-height: 1.35;
}

.home-footer {
  margin-top: auto;
  padding: 34rpx 34rpx 0;
}

.home-boundary {
  display: block;
  color: #8b9298;
  font-size: 20rpx;
  line-height: 1.5;
}

.utility-links {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 15rpx;
}

.utility-link {
  color: #3f6578;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.5;
}

.utility-dot {
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #bdc5ca;
}

@keyframes tool-card-in {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .tool-card {
    animation: none;
  }
}

.is-up { color: #a64b3f; }
.is-down { color: #3f6c55; }
.is-flat { color: #70777d; }
