.home-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(38rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 88% 8%, rgba(196, 158, 89, 0.1), transparent 32%),
    var(--paper);
}

.hero {
  position: relative;
  overflow: hidden;
  padding: calc(env(safe-area-inset-top) + 82rpx) 34rpx 78rpx;
  border-radius: 0 0 40rpx 40rpx;
  background: #211b15;
  color: #f7efe3;
}

.hero::after {
  content: "";
  position: absolute;
  right: -90rpx;
  bottom: -150rpx;
  width: 360rpx;
  height: 360rpx;
  border: 1rpx solid rgba(200, 166, 103, 0.16);
  border-radius: 50%;
}

.hero-watermark {
  position: absolute;
  right: 22rpx;
  top: -34rpx;
  color: rgba(240, 223, 190, 0.045);
  font-size: 270rpx;
  font-weight: 700;
  line-height: 1;
}

.brand-lockup {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-seal {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid rgba(213, 180, 116, 0.72);
  border-radius: 18rpx;
  background: rgba(173, 131, 61, 0.13);
}

.brand-seal-text {
  color: #d6b476;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

.brand-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 7rpx;
}

.brand-title {
  color: #fbf4e9;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 1.08;
}

.brand-subtitle {
  color: rgba(241, 226, 202, 0.66);
  font-size: 22rpx;
  letter-spacing: 0.08em;
  line-height: 1.4;
}

.hero-meta {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 42rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(225, 200, 157, 0.18);
  color: rgba(241, 226, 202, 0.54);
  font-size: 20rpx;
  letter-spacing: 0.14em;
}

.tool-grid {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: -42rpx;
  padding: 0 28rpx;
}

.tool-card {
  min-height: 206rpx;
  display: flex;
  align-items: stretch;
  flex-direction: column;
  margin: 0;
  padding: 24rpx 22rpx 22rpx;
  overflow: hidden;
  border: 1rpx solid rgba(117, 91, 48, 0.18);
  border-radius: 28rpx;
  background: #fbf7ef;
  color: var(--ink);
  line-height: 1.2;
  text-align: left;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.84);
  animation: tool-card-in 460ms cubic-bezier(0.16, 1, 0.3, 1) both;
  transition: transform 140ms cubic-bezier(0.16, 1, 0.3, 1), border-color 140ms ease, background-color 140ms ease;
}

.tool-card::after {
  border: 0;
}

.tool-card:nth-child(2) { animation-delay: 45ms; }
.tool-card:nth-child(3) { animation-delay: 90ms; }
.tool-card:nth-child(4) { animation-delay: 135ms; }
.tool-card:nth-child(5) { animation-delay: 180ms; }
.tool-card:nth-child(6) { animation-delay: 225ms; }

.tool-card-active {
  transform: scale(0.985);
  border-color: rgba(138, 103, 48, 0.52);
  background: #f7f0e4;
}

.tool-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.tool-icon-shell {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(138, 103, 48, 0.2);
  border-radius: 17rpx;
  background: #f1e5d2;
}

.tool-icon {
  width: 34rpx;
  height: 34rpx;
}

.tool-chevron {
  width: 12rpx;
  height: 12rpx;
  margin-top: 18rpx;
  margin-right: 4rpx;
  border-right: 1.5rpx solid #9b8769;
  border-bottom: 1.5rpx solid #9b8769;
  transform: rotate(-45deg);
}

.tool-title {
  display: block;
  margin-top: auto;
  padding-top: 24rpx;
  color: #251f18;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.01em;
  line-height: 1.3;
}

.tool-description {
  display: block;
  margin-top: 7rpx;
  color: #7b7061;
  font-size: 20rpx;
  line-height: 1.35;
}

.home-footer {
  margin-top: auto;
  padding: 34rpx 34rpx 0;
}

.home-boundary {
  display: block;
  color: #8a7e6d;
  font-size: 20rpx;
  line-height: 1.5;
}

.utility-links {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 15rpx;
}

.utility-link {
  color: #866528;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.5;
}

.utility-dot {
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #b9aa91;
}

@keyframes tool-card-in {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .tool-card {
    animation: none;
  }
}
