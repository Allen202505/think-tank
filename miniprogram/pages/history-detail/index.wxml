<view wx:if="{{record}}" class="page-shell detail-page">
  <view class="detail-meta">
    <text class="detail-type">{{record.typeText}}</text>
    <text class="detail-time">{{record.timeText}}</text>
  </view>

  <text class="detail-title serif">{{record.title}}</text>
  <text class="detail-summary">{{record.summary}}</text>

  <view wx:if="{{record.type === 'debate'}}" class="detail-body">
    <view wx:for="{{record.result.sections}}" wx:key="id" class="detail-section">
      <text class="detail-label">{{item.heading}}</text>
      <text class="detail-copy">{{item.content}}</text>
      <view wx:if="{{item.question}}" class="detail-question">
        <text class="detail-question-label">继续思考</text>
        <text class="detail-question-copy">{{item.question}}</text>
      </view>
    </view>
  </view>

  <view wx:elif="{{record.type === 'research'}}" class="detail-body">
    <view wx:if="{{record.result.metrics.length}}" class="detail-metrics">
      <view wx:for="{{record.result.metrics}}" wx:key="label" class="detail-metric">
        <text class="detail-metric-label">{{item.label}}</text>
        <text class="detail-metric-value serif">{{item.value}}</text>
        <text wx:if="{{item.note}}" class="detail-metric-note">{{item.note}}</text>
      </view>
    </view>
    <view wx:for="{{record.result.sections}}" wx:key="title" class="detail-section">
      <text class="detail-label">{{item.title}}</text>
      <text class="detail-copy">{{item.content}}</text>
      <text wx:for="{{item.bullets}}" wx:for-item="bullet" wx:key="*this" class="detail-research-bullet">· {{bullet}}</text>
    </view>
    <view wx:if="{{record.result.cards.length}}" class="detail-research-cards">
      <view wx:for="{{record.result.cards}}" wx:key="title" class="detail-research-card">
        <text class="detail-research-card-title">{{item.title}}</text>
        <text wx:if="{{item.subtitle}}" class="detail-research-card-copy">{{item.subtitle}}</text>
        <text wx:if="{{item.status}}" class="detail-research-card-status">{{item.status}}</text>
        <view wx:for="{{item.rows}}" wx:for-item="row" wx:key="label" class="detail-research-row">
          <text class="detail-research-row-label">{{row.label}}</text>
          <text class="detail-research-row-value">{{row.value}}</text>
        </view>
        <text wx:for="{{item.bullets}}" wx:for-item="note" wx:key="*this" class="detail-research-bullet">· {{note}}</text>
      </view>
    </view>
    <view wx:if="{{record.result.caveats.length}}" class="detail-uncertainty">
      <text class="detail-uncertainty-title">数据缺口与口径</text>
      <text wx:for="{{record.result.caveats}}" wx:key="*this" class="detail-uncertainty-copy">· {{item}}</text>
    </view>
  </view>

  <view wx:else class="detail-body">
    <view wx:for="{{record.result.points}}" wx:key="label" class="detail-section">
      <text class="detail-label">{{item.label}}</text>
      <text class="detail-copy">{{item.content}}</text>
    </view>
    <view wx:if="{{record.result.concepts.length}}" class="detail-concepts">
      <text class="detail-concepts-title serif">概念拆解</text>
      <view wx:for="{{record.result.concepts}}" wx:key="term" class="detail-concept-row">
        <text class="detail-concept-term">{{item.term}}</text>
        <text class="detail-copy">{{item.explanation}}</text>
      </view>
    </view>
    <view wx:if="{{record.result.uncertainties.length}}" class="detail-uncertainty">
      <text class="detail-uncertainty-title">仍需核实或观察</text>
      <text wx:for="{{record.result.uncertainties}}" wx:key="*this" class="detail-uncertainty-copy">· {{item}}</text>
    </view>
  </view>

  <view class="detail-source">
    <text class="detail-source-title">原始输入</text>
    <text class="detail-source-copy">{{record.source}}</text>
  </view>

  <view class="notice detail-notice">{{record.disclaimer}}</view>
  <button class="danger-button delete-button" bindtap="deleteRecord">删除这条记录</button>
</view>
