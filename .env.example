# 复制为 .env.local 并按需填写（.env.local 已被 gitignore，不会提交）

# 站点 URL（用于 sitemap/OG 等）
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 站长默认模型 Key：仅用于"未配置用户 Key"时的免费体验（默认 10 次）
# 支持任意 OpenAI 兼容服务（DeepSeek / MiMo 小米 / Kimi 等），改 MODEL + BASE_URL 即可切换
DEEPSEEK_API_KEY=sk-xxxx
# DeepSeek：
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# MiMo（小米，更便宜；代码已适配 api-key 头 / max_completion_tokens / 关闭思维链）：
# DEEPSEEK_MODEL=mimo-v2.5-pro
# DEEPSEEK_BASE_URL=https://api.xiaomimimo.com/v1

# Supabase：登录注册 + 股票池云端同步（key 仍留在用户本地）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
