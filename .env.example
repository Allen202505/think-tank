# 复制为 .env.local 并按需填写（.env.local 已被 gitignore，不会提交）

# 站点 URL（用于 sitemap/OG 等）
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 站长默认模型 Key：仅用于"未配置用户 Key"时的免费体验（默认 10 次）
# 支持任意 OpenAI 兼容服务（DeepSeek / MiMo 小米 / Kimi 等），改 MODEL + BASE_URL 即可切换
DEEPSEEK_API_KEY=sk-xxxx
# DeepSeek：
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# MiMo（小米，更便宜；代码已适配 api-key 头 / max_completion_tokens / 关闭思维链）：
# DEEPSEEK_MODEL=mimo-v2.5-pro
# DEEPSEEK_BASE_URL=https://api.xiaomimimo.com/v1

# Supabase：登录注册 + 股票池云端同步（key 仍留在用户本地）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# 服务端写入公共联赛底表（不要暴露到浏览器；仅 Vercel/服务器环境变量使用）
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# 收盘定时任务（Vercel Cron）鉴权：Vercel 会带 Authorization: Bearer $CRON_SECRET 调用 /api/cron/*
# CRON_SECRET=请填一个随机字符串

# 大师每日决策任务：并发数（批大小）与每日最多几个动作
# MASTER_LEAGUE_JOB_CONCURRENCY=6
# MASTER_LEAGUE_MAX_ACTIONS=3

# 大师智能体（每日自主决策）成本闸门：按需收紧，默认值已按「6 位大师每天约 ¥0.17」设定
# MASTER_LEAGUE_AGENT_TOKEN=           # 生产环境调用 /api/master-league/agent 的令牌（不配则仅非生产可用）
# MASTER_LEAGUE_AGENT_MAX_ROUNDS=4     # 单次运行最多几轮工具调用
# MASTER_LEAGUE_AGENT_MAX_TOOL_CALLS=8 # 单次运行最多几次工具调用（成本大头）
# MASTER_LEAGUE_AGENT_MAX_RUN_TOKENS=30000  # 单次运行 token 上限
# MASTER_LEAGUE_AGENT_DAILY_TOKEN_CAP=200000 # 进程内当日 token 上限，超出直接拒绝运行
# MASTER_LEAGUE_MAX_TOOL_RESULT_CHARS=4000   # 单个工具结果进上下文前的截断长度
# 价格表（元/百万 token，用于成本估算展示）
# MASTER_LEAGUE_PRICE_INPUT_MISS=2
# MASTER_LEAGUE_PRICE_INPUT_HIT=0.2
# MASTER_LEAGUE_PRICE_OUTPUT=3

# 大师动态雷达：RSSHub 实例地址（可选，默认 rsshub.pseudoyu.com）
# 生产建议自建 RSSHub（国内 VPS 更稳），并把 /xueqiu 的 Cookie 配到该实例
# RSSHUB_BASE=https://rsshub.example.com
