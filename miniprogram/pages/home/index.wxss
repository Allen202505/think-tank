.home-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(38rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 88% 8%, rgba(196, 158, 89, 0.1), transparent 32%),
    var(--paper);
}

.hero {
  position: relative;
  overflow: hidden;
  padding: calc(env(safe-area-inset-top) + 82rpx) 34rpx 78rpx;
  border-radius: 0 0 40rpx 40rpx;
  background: #211b15;
  color: #f7efe3;
}

.hero::after {
  content: "";
  position: absolute;
  right: -90rpx;
  bottom: -150rpx;
  width: 360rpx;
  height: 360rpx;
  border: 1rpx solid rgba(200, 166, 103, 0.16);
  border-radius: 50%;
}

.hero-watermark {
  position: absolute;
  right: 22rpx;
  top: -34rpx;
  color: rgba(240, 223, 190, 0.045);
  font-size: 270rpx;
  font-weight: 700;
  line-height: 1;
}

.brand-lockup {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-seal {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid rgba(213, 180, 116, 0.72);
  border-radius: 18rpx;
  background: rgba(173, 131, 61, 0.13);
}

.brand-seal-text {
  color: #d6b476;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

.brand-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 7rpx;
}

.brand-title {
  color: #fbf4e9;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  line-height: 1.08;
}

.brand-subtitle {
  color: rgba(241, 226, 202, 0.66);
  font-size: 22rpx;
  letter-spacing: 0.08em;
  line-height: 1.4;
}

.hero-meta {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 42rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(225, 200, 157, 0.18);
  color: rgba(241, 226, 202, 0.54);
  font-size: 20rpx;
  letter-spacing: 0.14em;
}

.home-main {
  position: relative;
  z-index: 2;
  margin-top: -42rpx;
  padding: 0 28rpx;
}

.dewater-card {
  position: relative;
  overflow: hidden;
  padding: 26rpx 24rpx 22rpx;
  border: 1rpx solid rgba(117, 91, 48, 0.22);
  border-radius: 30rpx;
  background: #fbf7ef;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), 0 18rpx 48rpx rgba(39, 31, 21, 0.08);
  transition: transform 140ms cubic-bezier(0.16, 1, 0.3, 1), border-color 140ms ease;
}

.dewater-card::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  width: 170rpx;
  height: 170rpx;
  background: radial-gradient(circle at 100% 0, rgba(165, 125, 59, 0.1), transparent 70%);
  pointer-events: none;
}

.dewater-card-active {
  transform: scale(0.988);
  border-color: rgba(138, 103, 48, 0.5);
}

.dewater-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.dewater-kicker,
.dewater-range,
.dewater-label,
.dewater-value,
.dewater-return {
  display: block;
}

.dewater-kicker {
  color: #2d261e;
  font-size: 27rpx;
  font-weight: 700;
}

.dewater-range {
  margin-top: 6rpx;
  color: #8e806c;
  font-size: 19rpx;
}

.dewater-link {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #8b6a31;
  font-size: 20rpx;
  font-weight: 600;
}

.dewater-link .tool-chevron {
  margin: 0;
  transform: rotate(-45deg);
}

.dewater-compare {
  display: flex;
  align-items: stretch;
  margin-top: 24rpx;
  padding: 22rpx 0 18rpx;
  border-top: 1rpx solid #e1d6c5;
}

.dewater-metric {
  min-width: 0;
  flex: 1;
}

.dewater-rule {
  width: 1rpx;
  margin: 0 22rpx;
  background: #e1d6c5;
}

.dewater-label {
  color: #817563;
  font-size: 19rpx;
}

.dewater-value {
  margin-top: 8rpx;
  color: #2b241c;
  font-size: 42rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
  line-height: 1.08;
}

.dewater-value.is-accent {
  color: #9c742e;
}

.dewater-return {
  margin-top: 8rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.dewater-chart {
  width: 100%;
  height: 142rpx;
  display: block;
}

.dewater-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 7rpx;
  color: #9a8d79;
  font-size: 18rpx;
  font-variant-numeric: tabular-nums;
}

.dewater-stale {
  display: block;
  margin-top: 12rpx;
  color: #9b732e;
  font-size: 18rpx;
}

.dewater-skeleton {
  min-height: 300rpx;
  color: #8a7d6a;
  font-size: 21rpx;
}

.skeleton-line {
  width: 68%;
  height: 18rpx;
  margin-bottom: 14rpx;
  border-radius: 10rpx;
  background: #e8dece;
}

.skeleton-line.wide { width: 92%; }
.skeleton-line.short { width: 45%; }

.dewater-error {
  min-height: 180rpx;
  display: flex;
  justify-content: center;
  flex-direction: column;
}

.dewater-error-title,
.dewater-error-copy {
  display: block;
}

.dewater-error-title {
  color: #332b22;
  font-size: 26rpx;
  font-weight: 700;
}

.dewater-error-copy {
  margin-top: 9rpx;
  color: #8b7e6c;
  font-size: 21rpx;
  line-height: 1.5;
}

.tool-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 30rpx 2rpx 14rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--line);
}

.tool-section-title {
  color: #4d4337;
  font-size: 23rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.tool-section-count {
  color: #a7977e;
  font-size: 18rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.12em;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.tool-card {
  min-height: 206rpx;
  display: flex;
  align-items: stretch;
  flex-direction: column;
  margin: 0;
  padding: 24rpx 22rpx 22rpx;
  overflow: hidden;
  border: 1rpx solid rgba(117, 91, 48, 0.18);
  border-radius: 28rpx;
  background: #fbf7ef;
  color: var(--ink);
  line-height: 1.2;
  text-align: left;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.84);
  animation: tool-card-in 460ms cubic-bezier(0.16, 1, 0.3, 1) both;
  transition: transform 140ms cubic-bezier(0.16, 1, 0.3, 1), border-color 140ms ease, background-color 140ms ease;
}

.tool-card::after {
  border: 0;
}

.tool-card:nth-child(2) { animation-delay: 45ms; }
.tool-card:nth-child(3) { animation-delay: 90ms; }
.tool-card:nth-child(4) { animation-delay: 135ms; }
.tool-card:nth-child(5) { animation-delay: 180ms; }
.tool-card:nth-child(6) { animation-delay: 225ms; }

.tool-card-active {
  transform: scale(0.985);
  border-color: rgba(138, 103, 48, 0.52);
  background: #f7f0e4;
}

.tool-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.tool-icon-shell {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(138, 103, 48, 0.2);
  border-radius: 17rpx;
  background: #f1e5d2;
}

.tool-icon {
  width: 34rpx;
  height: 34rpx;
}

.tool-chevron {
  width: 12rpx;
  height: 12rpx;
  margin-top: 18rpx;
  margin-right: 4rpx;
  border-right: 1.5rpx solid #9b8769;
  border-bottom: 1.5rpx solid #9b8769;
  transform: rotate(-45deg);
}

.tool-title {
  display: block;
  margin-top: auto;
  padding-top: 24rpx;
  color: #251f18;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.01em;
  line-height: 1.3;
}

.tool-description {
  display: block;
  margin-top: 7rpx;
  color: #7b7061;
  font-size: 20rpx;
  line-height: 1.35;
}

.home-footer {
  margin-top: auto;
  padding: 34rpx 34rpx 0;
}

.home-boundary {
  display: block;
  color: #8a7e6d;
  font-size: 20rpx;
  line-height: 1.5;
}

.utility-links {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 15rpx;
}

.utility-link {
  color: #866528;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.5;
}

.utility-dot {
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #b9aa91;
}

@keyframes tool-card-in {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .tool-card {
    animation: none;
  }
}

.is-up { color: #a64b3f; }
.is-down { color: #3f6c55; }
.is-flat { color: #7c7161; }
