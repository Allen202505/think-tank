{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "大师吵股组件",
  "version": "0.1.0",
  "identifier": "com.thinktank.widget",
  "build": {
    "devUrl": "http://localhost:4111/?api=http://localhost:3210",
    "frontendDist": "../"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "大师吵股 · 桌面组件",
        "label": "main",
        "width": 380,
        "height": 620,
        "minWidth": 340,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "Finance",
    "shortDescription": "大师吵股桌面组件：自选股行情、7×24 快讯与快速提问"
  }
}