.history-page {
  padding-top: 28rpx;
}

.history-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 28rpx;
  padding: 12rpx 0 30rpx;
}

.history-title,
.history-note {
  display: block;
}

.history-title {
  font-size: 46rpx;
  font-weight: 700;
}

.history-note {
  margin-top: 12rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
}

.clear-all {
  flex-shrink: 0;
  color: var(--danger);
  font-size: 25rpx;
  font-weight: 600;
}

.filter-row {
  display: flex;
  gap: 12rpx;
  padding-bottom: 26rpx;
  border-bottom: 1rpx solid var(--line-strong);
}

.filter-item {
  padding: 14rpx 26rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
}

.filter-item-active {
  border-color: var(--gold);
  background: rgba(234, 219, 184, 0.46);
  color: var(--ink);
  font-weight: 700;
}

.record-row {
  padding: 30rpx 4rpx;
  border-bottom: 1rpx solid var(--line);
}

.record-row-active {
  background: rgba(234, 219, 184, 0.22);
}

.record-meta,
.record-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.record-type {
  color: var(--gold);
  font-size: 23rpx;
  font-weight: 700;
}

.record-time {
  color: var(--ink-faint);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.record-title,
.record-summary {
  display: block;
}

.record-title {
  margin-top: 18rpx;
  color: var(--ink);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.45;
}

.record-summary {
  margin-top: 12rpx;
  color: var(--ink-soft);
  font-size: 25rpx;
  line-height: 1.65;
}

.record-footer {
  align-items: flex-end;
  margin-top: 22rpx;
}

.record-source {
  flex: 1;
  overflow: hidden;
  color: var(--ink-faint);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-delete {
  flex-shrink: 0;
  padding: 8rpx 4rpx 8rpx 20rpx;
  color: var(--danger);
  font-size: 23rpx;
}

.empty-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 40rpx 0;
  text-align: center;
}

.empty-title {
  color: var(--ink);
  font-size: 37rpx;
  font-weight: 700;
}

.empty-copy {
  max-width: 520rpx;
  margin-top: 18rpx;
  color: var(--ink-soft);
  font-size: 25rpx;
  line-height: 1.7;
}

.empty-action {
  width: 320rpx;
  margin-top: 42rpx;
}
