# 复制为 .env.local 并按需填写（.env.local 已被 gitignore，不会提交）

# 站点 URL（用于 sitemap/OG 等）
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# DeepSeek API Key：仅用于"未配置用户 Key"时的免费体验（默认 2 次）
DEEPSEEK_API_KEY=sk-xxxx
# 可选：默认模型与 Base URL（OpenAI 兼容）
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
